{
  "name": "graphdblite",
  "version": "0.3.0",
  "description": "Embedded graph database with Cypher support",
  "author": "ds7n",
  "keywords": ["graph", "database", "cypher", "embedded", "sqlite"],
  "homepage": "https://github.com/ds7n/graphdblite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ds7n/graphdblite.git"
  },
  "bugs": {
    "url": "https://github.com/ds7n/graphdblite/issues"
  },
  "main": "wrapper.js",
  "types": "wrapper.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "wrapper.js",
    "wrapper.d.ts",
    "README.md",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "graphdblite",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build-debug": "napi build --platform",
    "test": "node --test test/conformance.test.mjs test/wrapper.test.mjs test/snapshot.test.mjs test/index_ddl.test.mjs test/shortest_path.test.mjs test/review.test.mjs"
  }
}
