{
  "name": "graphdblite",
  "version": "0.1.1",
  "description": "Embedded graph database with Cypher support",
  "author": "ds7n",
  "keywords": ["graph", "database", "cypher", "embedded", "sqlite"],
  "homepage": "https://github.com/ds7n/graphdblite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ds7n/graphdblite.git"
  },
  "bugs": {
    "url": "https://github.com/ds7n/graphdblite/issues"
  },
  "main": "wrapper.js",
  "types": "wrapper.d.ts",
  "napi": {
    "name": "graphdblite",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build-debug": "napi build --platform",
    "test": "node --test test/conformance.test.mjs test/wrapper.test.mjs test/snapshot.test.mjs"
  }
}
