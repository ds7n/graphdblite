// graphdblite Cypher subset grammar (PEG)

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ ("--" | "//") ~ (!"\n" ~ ANY)* }

// === Top-level ===

statement = { SOI ~ union_stmt ~ ";"? ~ EOI }
union_stmt = { single_stmt ~ (union_op ~ single_stmt)* }
union_op = { ^"UNION" ~ ^"ALL"? }
single_stmt = { explain_stmt | match_create_stmt | match_merge_stmt | match_stmt | unwind_stmt | create_stmt | delete_stmt | set_stmt | merge_stmt | return_stmt }

explain_stmt = { ^"EXPLAIN" ~ (match_create_stmt | match_stmt | unwind_stmt) }

// === Standalone RETURN (no preceding MATCH) ===

return_stmt = {
    return_clause ~
    order_by_clause? ~
    skip_clause? ~
    limit_clause?
}

// === MATCH statement ===

match_stmt = {
    ^"MATCH" ~ pattern_list ~
    optional_match_clause* ~
    where_clause? ~
    (with_clause | unwind_clause)* ~
    return_clause ~
    order_by_clause? ~
    skip_clause? ~
    limit_clause?
}

with_clause = { ^"WITH" ~ return_items ~ order_by_clause? ~ skip_clause? ~ limit_clause? ~ where_clause? }

optional_match_clause = { ^"OPTIONAL" ~ ^"MATCH" ~ pattern_list }

// === UNWIND statement ===

unwind_stmt = {
    ^"UNWIND" ~ expr ~ ^"AS" ~ ident ~
    (unwind_create | unwind_return)
}

unwind_create = { ^"CREATE" ~ create_pattern_list }

unwind_return = {
    where_clause? ~
    return_clause ~
    order_by_clause? ~
    skip_clause? ~
    limit_clause?
}

// === UNWIND clause (within MATCH) ===

unwind_clause = { ^"UNWIND" ~ expr ~ ^"AS" ~ ident }

// === CREATE statement ===

create_stmt = {
    ^"CREATE" ~ create_pattern_list
}

create_pattern_list = { create_pattern ~ ("," ~ create_pattern)* }

create_pattern = { node_pattern ~ (rel_pattern ~ node_pattern)* }

// === MATCH ... CREATE statement ===

match_create_stmt = {
    ^"MATCH" ~ pattern_list ~
    where_clause? ~
    ^"CREATE" ~ create_pattern_list
}

// === MATCH ... MERGE statement ===

match_merge_stmt = {
    ^"MATCH" ~ pattern_list ~
    where_clause? ~
    ^"MERGE" ~ pattern ~
    on_create_clause? ~
    on_match_clause?
}

// === DELETE statement ===

delete_stmt = {
    ^"MATCH" ~ pattern_list ~
    optional_match_clause* ~
    where_clause? ~
    detach_keyword? ~ ^"DELETE" ~ ident_list
}

detach_keyword = { ^"DETACH" }

// === SET statement ===

set_stmt = {
    ^"MATCH" ~ pattern_list ~
    where_clause? ~
    ^"SET" ~ assignment_list
}

assignment_list = { assignment ~ ("," ~ assignment)* }
assignment = { property_access ~ "=" ~ expr }

// === MERGE statement ===

merge_stmt = {
    ^"MERGE" ~ pattern ~
    on_create_clause? ~
    on_match_clause?
}

on_create_clause = { ^"ON" ~ ^"CREATE" ~ ^"SET" ~ assignment_list }
on_match_clause = { ^"ON" ~ ^"MATCH" ~ ^"SET" ~ assignment_list }

// === Patterns ===

pattern_list = { pattern_item ~ ("," ~ pattern_item)* }
pattern_item = { path_pattern | pattern }
path_pattern = { ident ~ "=" ~ (shortest_path_fn | all_shortest_paths_fn) }
shortest_path_fn = { ^"shortestPath" ~ "(" ~ pattern ~ ")" }
all_shortest_paths_fn = { ^"allShortestPaths" ~ "(" ~ pattern ~ ")" }
pattern = { node_pattern ~ (rel_pattern ~ node_pattern)* }

node_pattern = { "(" ~ ident? ~ label_spec? ~ property_map? ~ ")" }
label_spec = { (":" ~ ident)+ }

rel_pattern = { rel_right | rel_left | rel_undirected }
rel_right = { "-[" ~ rel_detail ~ "]->" }
rel_left = { "<-[" ~ rel_detail ~ "]-" }
rel_undirected = { "-[" ~ rel_detail ~ "]-" }

rel_detail = { ident? ~ rel_type_spec? ~ property_map? ~ var_length? }
rel_type_spec = { ":" ~ ident ~ ("|" ~ ident)* }

var_length = { "*" ~ int_range? }
int_range = { integer ~ ".." ~ integer? }

// === Clauses ===

where_clause = { ^"WHERE" ~ bool_expr }

return_clause = { ^"RETURN" ~ distinct_keyword? ~ return_items }
distinct_keyword = { ^"DISTINCT" }
return_items = { return_item ~ ("," ~ return_item)* }
return_item = { expr ~ alias? }
alias = { ^"AS" ~ ident }

order_by_clause = { ^"ORDER" ~ ^"BY" ~ sort_items }
sort_items = { sort_item ~ ("," ~ sort_item)* }
sort_item = { expr ~ sort_direction? }
sort_direction = { ^"ASC" | ^"DESC" }

skip_clause = { ^"SKIP" ~ integer }
limit_clause = { ^"LIMIT" ~ integer }

// === Expressions ===

bool_expr = { bool_term ~ (or_op ~ bool_term)* }
bool_term = { bool_factor ~ (and_op ~ bool_factor)* }
bool_factor = { not_op? ~ bool_primary }
bool_primary = { case_expr | exists_subquery | is_not_null_check | is_null_check | in_check | comparison | "(" ~ bool_expr ~ ")" }

in_check = { expr ~ ^"IN" ~ expr }

exists_subquery = { ^"EXISTS" ~ "{" ~ pattern_list ~ where_clause? ~ "}" }

case_expr = {
    ^"CASE"
    ~ case_when_clause+
    ~ case_else_clause?
    ~ ^"END"
}
case_when_clause = { ^"WHEN" ~ bool_expr ~ ^"THEN" ~ expr }
case_else_clause = { ^"ELSE" ~ expr }

is_null_check = { expr ~ ^"IS" ~ ^"NULL" }
is_not_null_check = { expr ~ ^"IS" ~ ^"NOT" ~ ^"NULL" }
comparison = { expr ~ comp_op ~ expr }

or_op = { ^"OR" }
and_op = { ^"AND" }
not_op = { ^"NOT" }

comp_op = { "<>" | "<=" | ">=" | "<" | ">" | "=" | starts_with_op | ends_with_op | contains_op }
starts_with_op = { ^"STARTS" ~ ^"WITH" }
ends_with_op = { ^"ENDS" ~ ^"WITH" }
contains_op = { ^"CONTAINS" }

expr = { add_expr }
add_expr = { mul_expr ~ (add_op ~ mul_expr)* }
mul_expr = { atom_expr ~ (mul_op ~ atom_expr)* }
add_op = { "+" | "-" }
mul_op = { "*" | "/" }
atom_expr = { case_expr | function_call | property_access | literal | list_comprehension | list_literal | map_literal | star | parameter | "(" ~ add_expr ~ ")" | variable }

parameter = { "$" ~ ident }

list_comprehension = { "[" ~ ident ~ ^"IN" ~ expr ~ list_comp_where? ~ list_comp_map? ~ "]" }
list_comp_where = { ^"WHERE" ~ bool_expr }
list_comp_map = { "|" ~ expr }

list_literal = { "[" ~ (expr ~ ("," ~ expr)*)? ~ "]" }

// Map literal in expression context: {k: expr, k2: expr2, ...}. Uses distinct
// rule names from `property_map` (which is used in node/edge patterns with
// slightly different semantics and requires at least one pair).
map_literal = { "{" ~ (map_pair ~ ("," ~ map_pair)*)? ~ "}" }
map_pair = { ident ~ ":" ~ expr }

property_access = { ident ~ "." ~ ident }
variable = { ident }
star = { "*" }

function_call = { function_name ~ "(" ~ function_args ~ ")" }
function_name = @{ ^"count" | ^"sum" | ^"avg" | ^"min" | ^"max" | ^"collect" | ^"length" | ^"nodes" | ^"toLower" | ^"toUpper" | ^"toString" | ^"toInteger" | ^"toFloat" | ^"keys" | ^"id" | ^"coalesce" | ^"type" | ^"head" | ^"tail" | ^"last" | ^"size" | ^"abs" | ^"substring" | ^"replace" | ^"split" | ^"trim" | ^"reverse" | ^"range" }
function_args = { star | expr_list | "" }
expr_list = { expr ~ ("," ~ expr)* }

// === Property maps ===

property_map = { "{" ~ property_pair ~ ("," ~ property_pair)* ~ "}" }
property_pair = { ident ~ ":" ~ expr }

// === Identifiers and literals ===

ident_list = { ident ~ ("," ~ ident)* }

ident = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

keyword = {
    (^"MATCH" | ^"WHERE" | ^"RETURN" | ^"CREATE" | ^"DELETE" | ^"DETACH" | ^"SET" |
     ^"MERGE" | ^"ORDER" | ^"BY" | ^"SKIP" | ^"LIMIT" | ^"AND" | ^"OR" | ^"NOT" |
     ^"AS" | ^"IS" | ^"ON" | ^"ASC" | ^"DESC" | ^"STARTS" | ^"ENDS" | ^"WITH" | ^"CONTAINS" |
     ^"OPTIONAL" | ^"UNWIND" | ^"TRUE" | ^"FALSE" | ^"NULL" |
     ^"CASE" | ^"WHEN" | ^"THEN" | ^"ELSE" | ^"END" | ^"EXISTS" | ^"IN" | ^"DISTINCT" | ^"UNION" | ^"ALL" |
     ^"shortestPath" | ^"allShortestPaths" | ^"EXPLAIN" |
     ^"count" | ^"sum" | ^"avg" | ^"min" | ^"max" | ^"collect" | ^"length" | ^"nodes")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

literal = { float_literal | integer_literal | string_literal | bool_literal | null_literal }

integer_literal = @{ "-"? ~ ASCII_DIGIT+ }
float_literal = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
string_literal = ${ "'" ~ string_inner ~ "'" }
string_inner = @{ (!"'" ~ !"\\" ~ ANY | "\\" ~ ANY)* }
bool_literal = { ^"TRUE" | ^"FALSE" }
null_literal = { ^"NULL" }

integer = @{ ASCII_DIGIT+ }
